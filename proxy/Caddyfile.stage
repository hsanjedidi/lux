localhost:80 {
    redir https://localhost:443{uri}
}




localhost:443 {

    # -----------------------
    # API reverse proxy
    # -----------------------
    handle /api/* {
        reverse_proxy api:3000
    }

    root * /srv/web
    encode gzip
    file_server
    try_files {path} /index.html

    log {
		level ERROR
        format console
    }
}

